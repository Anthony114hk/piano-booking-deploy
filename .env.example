# Copy this file to .env and fill in real values before `docker compose up`.

# Database — used by both wordpress and db services
WORDPRESS_DB_NAME=pianobooking
WORDPRESS_DB_USER=pbuser
WORDPRESS_DB_PASSWORD=replace_me_with_a_strong_random_string
MARIADB_ROOT_PASSWORD=replace_me_with_another_strong_random_string

# Public URL — what the site thinks its own URL is.
# Set this to your Cloudflare tunnel URL (e.g. https://piano.example.trycloudflare.com)
# or your real domain if you have one. Used for WP_HOME / WP_SITEURL.
WP_HOME=https://piano-tunnel.trycloudflare.com